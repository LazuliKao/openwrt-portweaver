{
  "name": "@portweaver/luci-ui",
  "version": "1.0.0",
  "description": "LuCI PortWeaver UI TypeScript source",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "check": "biome check",
    "dev": "rsbuild dev",
    "dev:remote": "dotenvx run -- luci-types dev",
    "preview": "rsbuild preview",
    "format": "biome format --write",
    "lint": "biome lint --write --unsafe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:export": "dotenvx run -- luci-types i18n"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@dotenvx/dotenvx": "^1.71.3",
    "@lazulikao/luci-types": "github:LazuliKao/luci-types#fe8946745d87eaf7d49156dd76a55186cf8c7fae",
    "@rsbuild/core": "^2.0.12",
    "@types/node": "^20.19.43",
    "@types/ssh2": "^1.15.5",
    "chokidar": "^5.0.0",
    "monaco-editor": "0.56.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
